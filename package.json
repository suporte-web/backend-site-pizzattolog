{
  "name": "site_pizzattolog_backend",
  "version": "1.0.0",
  "description": "Backend do site institucional da Pizzattolog",
  "private": true,
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run build && node --test --experimental-test-isolation=none tests/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  }
}

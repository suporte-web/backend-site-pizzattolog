model Solucao {
  id           String   @id @default(uuid())
  titulo       String
  slug         String   @unique
  descricao    String
  icone        String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("solucoes")
}

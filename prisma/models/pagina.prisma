model Pagina {
  id           String       @id @default(uuid())
  titulo       String
  slug         String       @unique
  resumo       String?
  conteudo     String
  status       StatusPagina @default(RASCUNHO)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@map("paginas")
}

enum StatusPagina {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}

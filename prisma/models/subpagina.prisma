model Subpagina {
  id           String   @id @default(uuid())
  titulo       String
  slug         String   @unique
  paginaPai    String
  caminho      String
  ancora       String?
  descricao    String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([paginaPai])
  @@map("subpaginas")
}
